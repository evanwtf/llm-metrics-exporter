# Docker Compose reads .env automatically; no shell exports or sourcing needed.
# Copy to .env and edit locally. Do not commit private deployment settings.
# Engine endpoint/model are required only for the one-shot register service.

# One-shot setup: docker compose run --rm --build register
LLM_ENGINE=vllm
LLM_ENGINE_ENDPOINT=http://127.0.0.1:<engine-port>
LLM_ENGINE_MODEL=<model-identity>
# Exact upstream model name; empty accepts a single model, rejects ambiguity.
LLM_ENGINE_SERVED_MODEL=
LLM_ENGINE_BACKEND=local-model
LLM_ENGINE_NODES=1
LLM_ENGINE_RUN_ID=static
LLM_ENGINE_ISSUE=0
# Container-visible absolute path for ds4/MTPLX only. Mount the corresponding
# directory in the exporter as described in compose.yaml; MTPLX is planned.
LLM_ENGINE_LOG_PATH=
LLM_ENGINE_TRACE_PATH=
# Registration writer must own/have write access to the host directory.
# Replace with the output of `id -u` and `id -g` (1000 is only a common default).
LLM_EXPORTER_UID=1000
LLM_EXPORTER_GID=1000

# Stable, unique identity for this inference host, not the container hostname.
LLM_EXPORTER_HOST=
# where launchers write registrations on the host
LLM_EXPORTER_REGISTRATION_DIR=
# exporter listen address; the image healthcheck probes :9109, so override
# healthcheck.test in compose.yaml if you change the port
LLM_EXPORTER_LISTEN=:9109
# No engine/model settings needed: discover local engines continuously.
LLM_EXPORTER_DISCOVERY=local
# 0 = unknown; assert 2 only if ALL discovered deployments always span two nodes.
LLM_EXPORTER_DISCOVERY_NODES=0
# Optional comma-separated loopback HTTP URLs, replacing listener enumeration.
LLM_EXPORTER_DISCOVERY_ENDPOINTS=
# git revision baked into the image (docker compose build)
REVISION=
# Prometheus Agent (--profile agent): its config and listen address
PROMETHEUS_AGENT_CONFIG=./prometheus-agent.local.yml
PROMETHEUS_AGENT_LISTEN=127.0.0.1:9095
