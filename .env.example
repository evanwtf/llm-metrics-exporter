# docker compose settings. Copy to .env; every variable is optional.

# host label; empty means the host's short hostname
LLM_EXPORTER_HOST=
# where launchers write registrations on the host
LLM_EXPORTER_REGISTRATION_DIR=
# exporter listen address; the image healthcheck probes :9109, so override
# healthcheck.test in compose.yaml if you change the port
LLM_EXPORTER_LISTEN=:9109
# git revision baked into the image (docker compose build)
REVISION=
# Prometheus Agent (--profile agent): its config and listen address
PROMETHEUS_AGENT_CONFIG=./prometheus-agent.local.yml
PROMETHEUS_AGENT_LISTEN=127.0.0.1:9095
